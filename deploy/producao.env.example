# Copie para ~/.config/rest-system/producao.env (chmod 600). NUNCA commitar o arquivo real.
DATABASE_URL=postgresql+asyncpg://rest_system_prod:SENHA_DO_BANCO@127.0.0.1:5432/rest_system_prod
REDIS_URL=redis://127.0.0.1:6379/1
# Canal próprio: o pub/sub do Redis ignora o número do banco, dev e produção não podem dividir canal.
CANAL_EVENTOS=rest_system_prod:eventos
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=TROQUE
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=https://rest-system.tail9ff58.ts.net
PUBLIC_BASE_URL=https://rest-system.tail9ff58.ts.net
TIMEZONE_LOCAL=America/Manaus
EXPOR_DOCS=false
FRONTEND_DIST=/home/SEU_USUARIO/.local/share/rest-system/atual/frontend/dist
